# Variables de entorno del servidor de n8n. Copia a .env en el servidor; nunca subas el .env.

# Necesario para que los workflows puedan leer $env
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
GENERIC_TIMEZONE=Atlantic/Canary

# LLM (https://openrouter.ai/keys)
OPENROUTER_API_KEY=pon-aqui-tu-clave-de-openrouter

# Chat de Telegram que recibe informes y borradores
TELEGRAM_CHAT_ID=pon-aqui-el-id-de-tu-chat
